% All personal fields live in metadata.tex.
\newcommand{\University}{نام دانشگاه}
\newcommand{\Department}{نام دانشکده}
\newcommand{\Course}{نام درس}
\newcommand{\AssignmentNumber}{۱}
\newcommand{\AssignmentTitle}{عنوان تمرین}
\newcommand{\StudentName}{نام و نام خانوادگی}
\newcommand{\StudentID}{شماره دانشجویی}
\newcommand{\Instructor}{نام استاد}
\newcommand{\Semester}{نیمسال تحصیلی}
\newcommand{\DueDate}{تاریخ تحویل}
\newcommand{\HeaderCourse}{\Course}
\newcommand{\UniversityLogo}{assets/aut-logo.png}
\newcommand{\DepartmentLogo}{assets/bme-logo.png}

% Native page styles use the RTL context set by bidi's output routine.
% Keep font/direction commands scoped; headers work across multi-page listings.
\makeatletter
\newcommand{\AssignmentHeader}{%
  {\normalfont\setpersianfont\small\color{AssignmentMuted}%
    \HeaderCourse\hfil تمرین \AssignmentNumber}}
\newcommand{\AssignmentFooter}{%
  \hfil{\normalfont\setpersianfont\small\color{AssignmentMuted}%
    صفحهٔ \thepage\ از \pageref*{LastPage}}\hfil}
\def\ps@assignment{%
  \def\@oddhead{\AssignmentHeader}\let\@evenhead\@oddhead
  \def\@oddfoot{\AssignmentFooter}\let\@evenfoot\@oddfoot}
\def\ps@assignmentfirst{%
  \let\@oddhead\@empty\let\@evenhead\@empty
  \def\@oddfoot{\AssignmentFooter}\let\@evenfoot\@oddfoot}
% Match equation tags and references: Latin digits, always left-to-right.
\def\tagform@#1{\maketag@@@{\lr{(\ignorespaces#1\unskip\@@italiccorr)}}}
\makeatother
\pagestyle{assignment}

\newcommand{\MakeAssignmentTitle}{%
  % The unnumbered cover must not reuse the body page.1 hyperlink anchor.
  \hypersetup{pageanchor=false,
    pdftitle={\Course: \AssignmentTitle},pdfauthor={\StudentName}}%
  \begin{titlepage}
    \thispagestyle{empty}%
    \centering
    \setstretch{1.2}%
    \setlength{\parskip}{0pt}%
    \vspace*{2mm}
    % Explicit LTR placement keeps the faculty on the left and AUT on the right.
    \begin{LTR}
      \noindent
      \begin{minipage}[t]{.38\linewidth}
        \centering
        \vspace{0pt}
        % The faculty's official mark is white, so retain it on a navy backing.
        \parbox[c][36mm][c]{\linewidth}{\centering
          \tcbox[enhanced,colback=AssignmentLogoBlue,colframe=AssignmentLogoBlue,
            boxrule=0pt,arc=2mm,boxsep=0pt,left=2mm,right=2mm,
            top=2mm,bottom=2mm,before skip=0pt,after skip=0pt]{%
            \includegraphics[width=30mm,height=30mm,keepaspectratio]{\DepartmentLogo}}}\par
        \vspace{3mm}
        {\small\bfseries\color{AssignmentInk}\rl{\Department}\par}
      \end{minipage}\hfill
      \begin{minipage}[t]{.38\linewidth}
        \centering
        \vspace{0pt}
        \parbox[c][36mm][c]{\linewidth}{\centering
          \includegraphics[width=34mm,height=34mm,keepaspectratio]{\UniversityLogo}}\par
        \vspace{3mm}
        {\small\bfseries\color{AssignmentInk}\rl{\University}\par}
      \end{minipage}\par
    \end{LTR}
    \vspace{5mm}
    \vspace{\stretch{2}}
    {\large\color{AssignmentAccent}تمرین \AssignmentNumber\par}
    \vspace{5mm}
    \begin{minipage}{.92\linewidth}
      \centering
      {\fontsize{28}{39}\selectfont\bfseries\color{AssignmentInk}
        \AssignmentTitle\par}
      \vspace{4mm}
      {\fontsize{16}{24}\selectfont\color{AssignmentAccent}\Course\par}
    \end{minipage}\par
    \vspace{12mm}
    {\color{AssignmentLine}\rule{.66\linewidth}{.5pt}\par}
    \vspace{9mm}
    \begin{minipage}{.84\linewidth}
      \centering
      {\small\color{AssignmentMuted}دانشجو\par}
      \vspace{1mm}
      {\fontsize{15}{23}\selectfont\bfseries\color{AssignmentInk}
        \StudentName\par}
      \vspace{2mm}
      {\small\color{AssignmentMuted}شماره دانشجویی:
        \enspace\textcolor{AssignmentInk}{\StudentID}\par}
      \vspace{7mm}
      {\small\color{AssignmentMuted}استاد درس\par}
      \vspace{1mm}
      {\fontsize{14}{22}\selectfont\color{AssignmentInk}\Instructor\par}
    \end{minipage}\par
    \vspace{\stretch{3}}
    \begin{minipage}[t]{.43\linewidth}
      \centering
      {\small\color{AssignmentMuted}نیمسال تحصیلی\par}
      \vspace{2mm}
      {\large\color{AssignmentInk}\Semester\par}
    \end{minipage}\hspace{.06\linewidth}%
    \begin{minipage}[t]{.43\linewidth}
      \centering
      {\small\color{AssignmentMuted}تاریخ تحویل\par}
      \vspace{2mm}
      {\large\color{AssignmentInk}\LRE{\DueDate}\par}
    \end{minipage}\par
    \vspace*{4mm}
  \end{titlepage}
  \setcounter{page}{1}%
  \hypersetup{pageanchor=true}%
}

\tcbset{assignment box/.style={enhanced,breakable,arc=1.5mm,
  boxrule=.75pt,colback=AssignmentBoxBack,colframe=AssignmentBoxBorder,
  colbacktitle=AssignmentBoxTitle,coltitle=white,
  drop fuzzy shadow=AssignmentBoxShadow,
  fonttitle=\bfseries,left=4mm,right=4mm,top=2.5mm,bottom=2.5mm,
  before skip=3mm,after skip=3mm}}

% A problem contains the statement; put the solution AFTER the problem box.
\newcounter{problem}
\newcounter{partquestion}[problem]
\renewcommand{\theproblem}{\arabic{problem}}
\numberwithin{equation}{problem}
% Sub-equation suffixes stay Latin even inside Persian paragraphs.
\AddToHook{env/subequations/begin}{\LatinAlphs}
\NewDocumentEnvironment{problem}{O{} m}{%
  \Needspace{6\baselineskip}%
  \refstepcounter{problem}%
  \addcontentsline{toc}{section}{تمرین \theproblem: #2}%
  \begin{tcolorbox}[assignment box,
    title={سوال \theproblem\enspace |\enspace #2\hfill
      \if\relax\detokenize{#1}\relax\else{\small #1}\fi}]%
}{\end{tcolorbox}}

\NewDocumentEnvironment{solution}{O{پاسخ}}{%
  \par\Needspace{3\baselineskip}
  {\bfseries\color{AssignmentAccent}#1}\par\nobreak
}{\par\medskip}
\newcommand{\Part}[1]{%
  \par\Needspace{3\baselineskip}\refstepcounter{partquestion}
  {\bfseries\color{AssignmentInk}\alph{partquestion})\enspace #1}\par\nobreak}
\newtcolorbox{answerbox}[1][نتیجهٔ نهایی]{assignment box,
  colback=AssignmentBoxResult,colframe=AssignmentBoxTitle,title={#1}}
\newtcolorbox{notebox}[1][نکته]{assignment box,
  colback=AssignmentPaper,colbacktitle=AssignmentBoxNoteTitle,
  coltitle=AssignmentInk,title={#1},fontupper=\small}

\newtheoremstyle{assignment theorem}{6pt}{6pt}{\normalfont}{}%
  {\bfseries\color{AssignmentAccent}}{.}{.5em}{}
\theoremstyle{assignment theorem}
\newtheorem{theorem}{قضیه}[problem]
\newtheorem{lemma}[theorem]{لم}
\newtheorem{definition}[theorem]{تعریف}
\renewcommand{\proofname}{اثبات}
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\E}{\mathbb{E}}
\newcommand{\vect}[1]{\bm{#1}}
\newcommand{\mat}[1]{\mathbf{#1}}
\newcommand{\dd}{\mathop{}\!\mathrm{d}}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\inner}{\langle}{\rangle}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}
\newcommand{\eqnref}[1]{\lr{\eqref{#1}}}
